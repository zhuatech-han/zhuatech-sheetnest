{
  "name": "zhuatech-sheetnest-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SheetNest · 知华板材排样与切割结果复核，整数贯穿切割启发式、独立方案复核与人工结果登记；非商业源码学习版",
  "author": "上海如静知华信息科技有限公司",
  "homepage": "https://www.zhuatech.cn/",
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint src vite.config.js",
    "format": "prettier --write src vite.config.js index.html package.json",
    "format:check": "prettier --check src vite.config.js index.html package.json",
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "vue": "3.5.40",
    "@lucide/vue": "1.48.0"
  },
  "devDependencies": {
    "vite": "8.1.5",
